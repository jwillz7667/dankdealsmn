# ============================================================
# DankDeals — environment template
# Copy to .env (root, for db tooling), apps/api/.env, apps/web/.env.local
# NEVER commit real secrets. Both apps validate these at boot (Zod) and fail fast.
#
# Production topology:
#   • Web (Next.js)  → Vercel        → https://dankdealsmn.com
#   • API (Fastify)  → Railway       → https://api.dankdealsmn.com
#   • Postgres+Redis → Railway plugins
#   • Media (images) → Cloudflare R2 → https://media.dankdealsmn.com
# ============================================================

# ---------- Database (packages/db, apps/api) ----------
# Production: Railway injects these — reference the Postgres plugin in the API service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   DIRECT_URL=${{Postgres.DATABASE_URL}}
# Use the pooled URL for DATABASE_URL and the direct (non-pooled) URL for DIRECT_URL
# when running behind pgbouncer; Prisma migrations use DIRECT_URL.
DATABASE_URL="postgresql://dankdeals:dankdeals@localhost:5432/dankdeals?schema=public"
DIRECT_URL="postgresql://dankdeals:dankdeals@localhost:5432/dankdeals?schema=public"
# Production: REDIS_URL=${{Redis.REDIS_URL}}
REDIS_URL="redis://localhost:6379"

# ---------- API (apps/api, Railway) ----------
# Railway sets PORT automatically; API_PORT mirrors it for local runs.
API_PORT="4000"
NODE_ENV="production"
# Comma-separated allowed browser origins for CORS (the web app).
WEB_ORIGIN="https://dankdealsmn.com"
# Local dev: WEB_ORIGIN="http://localhost:3000"
# Shared secret used to verify the per-user JWT minted by the web app. 32+ random bytes.
AUTH_API_JWT_SECRET="change-me-generate-with-openssl-rand-base64-32"
# Internal service token for trusted server-to-server calls (web → API for admin/account).
API_SERVICE_TOKEN="change-me-generate-with-openssl-rand-base64-32"

# ---------- Cloudflare R2 (apps/api owns credentials; web only needs the public base) ----------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="dankdeals-media"
# Public CDN base for serving images (custom domain or r2.dev). Used by next/image too.
R2_PUBLIC_BASE_URL="https://media.dankdealsmn.com"

# ---------- Email (Resend) — magic link + order notifications ----------
RESEND_API_KEY=""
EMAIL_FROM="DankDeals <orders@dankdealsmn.com>"

# ---------- Web / Auth.js (apps/web, Vercel) ----------
# The API the browser + server components call. Railway service behind a custom domain.
NEXT_PUBLIC_API_URL="https://api.dankdealsmn.com"
# If no custom domain is attached on Railway, use the generated URL instead, e.g.
# NEXT_PUBLIC_API_URL="https://dankdeals-api-production.up.railway.app"
# Local dev: NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="https://dankdealsmn.com"
# Public media/CDN base (next/image remotePatterns + image rendering).
NEXT_PUBLIC_MEDIA_BASE_URL="https://media.dankdealsmn.com"
# Auth.js session secret. 32+ random bytes (openssl rand -base64 32).
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_URL="https://dankdealsmn.com"
# Local dev: AUTH_URL="http://localhost:3000"
# Cookie domain so the session is shared with api.dankdealsmn.com in prod (leave blank locally).
AUTH_COOKIE_DOMAIN=".dankdealsmn.com"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
